{
  "name": "lunar-rescue",
  "productName": "Lunar Rescue",
  "version": "1.0.0",
  "description": "Lunar Rescue",
  "main": "main.js",
  "author": "You",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yourname.lunarrescue",
    "productName": "Lunar Rescue",
    "files": [
      "main.js",
      "index.html",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}